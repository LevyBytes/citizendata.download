{
  "manifest_version": 3,
  "name": "Citizen Data Downloader",
  "short_name": "Star Citizen Data Downloader",
  "version": "0.42.2",
  "version_name": "0.42.2",
  "description": "Back up your Star Citizen hangar, buybacks, billing, referrals and org members to a file on your device. No upload, no tracking.",
  "minimum_chrome_version": "120",
  "homepage_url": "https://citizendata.download/",
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/citizendata-16.png",
    "32": "icons/citizendata-32.png",
    "48": "icons/citizendata-48.png",
    "128": "icons/citizendata-128.png"
  },
  "action": {
    "default_title": "Star Citizen Data Downloader",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/citizendata-16.png",
      "32": "icons/citizendata-32.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "alarms",
    "cookies",
    "offscreen",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://robertsspaceindustries.com/*"
  ],
  "optional_host_permissions": [
    "https://status.robertsspaceindustries.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://citizendata.download/*",
        "file:///*/docs/index.html"
      ],
      "js": [
        "shared/protocol.js",
        "content/dashboard-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
