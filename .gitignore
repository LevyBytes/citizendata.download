dist/
node_modules/
*.log
*.tmp
*.pem
*.crx

# Files operating systems and desktops leave in folders, ignored in every folder of the repository.
# Windows: thumbnail caches, folder settings, shortcuts, the recycle bin, download zone marks copied by WSL.
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump
*:Zone.Identifier
# macOS: Finder settings, resource forks, Spotlight, Trash, Time Machine and volume files.
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.DocumentRevisions-V100
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
# Linux: desktop folder settings, trash folders, FUSE and NFS leftovers, editor backup copies.
.directory
.Trash-*
.fuse_hidden*
.nfs*
*~

# Screenshots and scratch folders that test runs write next to the tests.
work-temp-*

# Never commit local account exports or captured RSI pages.
account-data*.json
rsi-account*.json
citizendata-*.json
citizendata-*.zip
hangarlink*.json
!tests/web/readability/citizendata-states.json
private-data/
captures/
fixtures/private/

